# Port the server listens on locally
PORT=3000

# Base URL used in local startup log / HTTP-Referer header
URL=http://localhost

# Base URL for the Anthropic-compatible API (required)
ANTHROPIC_BASE_URL=

# Bearer token for the Authorization header (required)
ANTHROPIC_AUTH_TOKEN=

# Default model used when a request doesn't specify one (optional)
ANTHROPIC_MODEL=
